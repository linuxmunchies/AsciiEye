#!/usr/bin/env bash
# Start, stop, and inspect the local AsciiEye dev server.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

RUN_DIR="$ROOT/.run"
PID_FILE="$RUN_DIR/dev.pid"
LOG_FILE="$RUN_DIR/dev.log"
PORT="${PORT:-3000}"
CMD="${1:-start}"

usage() {
  cat <<'EOF'
Usage: ./run [command]

  start      Start the local dev server (default)
  stop       Stop the local dev server
  restart    Stop, then start
  status     Show whether it is running
  logs       Follow the dev log (Ctrl-C to detach)
  help       Show this help

Examples:
  ./run
  ./run stop
  PORT=3001 ./run start
  npm run up
  npm run down
EOF
}

is_pid_alive() {
  local pid="${1:-}"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

read_pid() {
  if [[ -f "$PID_FILE" ]]; then
    tr -d '[:space:]' <"$PID_FILE"
  fi
}

kill_tree() {
  local pid="$1"
  local child
  for child in $(pgrep -P "$pid" 2>/dev/null || true); do
    kill_tree "$child"
  done
  kill "$pid" 2>/dev/null || true
}

detect_url() {
  if [[ -f "$LOG_FILE" ]]; then
    grep -Eo 'https?://(localhost|127\.0\.0\.1):[0-9]+' "$LOG_FILE" | tail -n 1 || true
  fi
}

wait_for_url() {
  local i
  for i in $(seq 1 80); do
    local url
    url="$(detect_url)"
    if [[ -n "$url" ]]; then
      printf '%s\n' "$url"
      return 0
    fi
    sleep 0.25
  done
  return 1
}

status() {
  local pid
  pid="$(read_pid)"
  if is_pid_alive "$pid"; then
    local url
    url="$(detect_url)"
    echo "running  pid=$pid  ${url:-waiting for url}"
    return 0
  fi
  echo "stopped"
  return 1
}

stop() {
  local pid
  pid="$(read_pid)"
  if ! is_pid_alive "$pid"; then
    rm -f "$PID_FILE"
    echo "already stopped"
    return 0
  fi
  kill_tree "$pid"
  local i
  for i in $(seq 1 20); do
    is_pid_alive "$pid" || break
    sleep 0.1
  done
  if is_pid_alive "$pid"; then
    kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE"
  echo "stopped"
}

start() {
  local pid
  pid="$(read_pid)"
  if is_pid_alive "$pid"; then
    echo "already running  pid=$pid  $(detect_url)"
    return 0
  fi

  if [[ ! -d "$ROOT/node_modules" ]]; then
    echo "installing dependencies…"
    npm install
  fi

  mkdir -p "$RUN_DIR"
  : >"$LOG_FILE"

  echo "starting AsciiEye on port $PORT…"
  nohup env PORT="$PORT" npm run dev >>"$LOG_FILE" 2>&1 &
  echo $! >"$PID_FILE"

  local url
  if url="$(wait_for_url)"; then
    echo "ready  $url"
    echo "stop with:  ./run stop"
  else
    echo "started pid=$(read_pid) but no URL appeared yet"
    echo "check logs:  ./run logs"
    return 1
  fi
}

logs() {
  mkdir -p "$RUN_DIR"
  touch "$LOG_FILE"
  echo "following $LOG_FILE  (Ctrl-C detaches, server keeps running)"
  exec tail -n 80 -f "$LOG_FILE"
}

case "$CMD" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  logs|log|tail) logs ;;
  help|-h|--help) usage ;;
  *)
    echo "unknown command: $CMD" >&2
    usage >&2
    exit 2
    ;;
esac
